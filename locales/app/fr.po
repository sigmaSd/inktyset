msgctxt "scanLabel"
msgid "Scan {time}"
msgstr "Scan {time}"

msgctxt "phoneLabel"
msgid "Phone photo {name}"
msgstr "Photo du téléphone {name}"

msgctxt "pagesFolderTitle"
msgid "Folder for your pages"
msgstr "Dossier pour vos pages"

msgctxt "folderUnavailable"
msgid "Your pages folder {p} could not be opened ({e}); Inktyset is using {d} for now."
msgstr "Votre dossier de pages {p} n'a pas pu être ouvert ({e}) ; Inktyset utilise {d} pour l'instant."

msgctxt "modelFolderTitle"
msgid "Folder with Qwen3.5-9B-Q4_K_M.gguf and mmproj-F16.gguf"
msgstr "Dossier contenant Qwen3.5-9B-Q4_K_M.gguf et mmproj-F16.gguf"

msgctxt "notPicture"
msgid "This file could not be opened as a picture or PDF ({error})."
msgstr "Ce fichier n'a pas pu être ouvert comme image ou PDF ({error})."

msgctxt "previewFailed"
msgid "The preview could not be built."
msgstr "L'aperçu n'a pas pu être créé."

msgctxt "noLatexAtAll"
msgid "No working LaTeX was found, and Tectonic is not available for this system."
msgstr "Aucun LaTeX fonctionnel n'a été trouvé, et Tectonic n'est pas disponible pour ce système."

msgctxt "tectonicMissing"
msgid "Tectonic was downloaded but could not be found."
msgstr "Tectonic a été téléchargé mais reste introuvable."

msgctxt "noInstalledLatex"
msgid "No installed LaTeX was found."
msgstr "Aucun LaTeX installé n'a été trouvé."

msgctxt "noInstalledLatexHelp"
msgid "No installed LaTeX was found. Choose Automatic or Built-in in Settings."
msgstr "Aucun LaTeX installé n'a été trouvé. Choisissez Automatique ou Intégré dans les Paramètres."

msgctxt "tectonicFallback"
msgid "Tectonic (the installed LaTeX failed a test for {lang})"
msgstr "Tectonic (le LaTeX installé a échoué à un test pour {lang})"

msgctxt "noTypst"
msgid "Typst is not installed, and no Typst download exists for this system."
msgstr "Typst n'est pas installé, et aucun téléchargement de Typst n'existe pour ce système."

msgctxt "typstMissing"
msgid "Typst was downloaded but could not be found."
msgstr "Typst a été téléchargé mais reste introuvable."

msgctxt "damaged"
msgid "The download of {file} was damaged. Try again."
msgstr "Le téléchargement de {file} est endommagé. Réessayez."

msgctxt "unpackFailed"
msgid "Could not unpack {file}: {error}"
msgstr "Impossible de décompresser {file} : {error}"

msgctxt "downloadStopped"
msgid "Download stopped."
msgstr "Téléchargement arrêté."

msgctxt "downloadFailed"
msgid "Download of {file} failed: {error}"
msgstr "Échec du téléchargement de {file} : {error}"

msgctxt "scannerNoAnswer"
msgid "The scanner did not respond: {error}"
msgstr "Le scanner n'a pas répondu : {error}"

msgctxt "scanFailed"
msgid "scan failed"
msgstr "échec de la numérisation"

msgctxt "notDownloaded"
msgid "The engine or the model is not downloaded yet."
msgstr "Le moteur ou le modèle n'est pas encore téléchargé."

msgctxt "modelStoppedCode"
msgid "The model stopped (code {code}). See engine.log."
msgstr "Le modèle s'est arrêté (code {code}). Voir engine.log."

msgctxt "modelTimeout"
msgid "The model did not load in time."
msgstr "Le modèle ne s'est pas chargé à temps."

msgctxt "engineAnswered"
msgid "The engine answered {status}: {text}"
msgstr "Le moteur a répondu {status} : {text}"

msgctxt "finishing"
msgid "Finishing {n} page in the background. Open Inktyset to watch."
msgid_plural "Finishing {n} pages in the background. Open Inktyset to watch."
msgstr[0] "Inktyset termine {n} page en arrière-plan. Ouvrez-le pour suivre."
msgstr[1] "Inktyset termine {n} pages en arrière-plan. Ouvrez-le pour suivre."

msgctxt "stillReading"
msgid "{n} page is still to read."
msgid_plural "{n} pages are still to read."
msgstr[0] "Il reste {n} page à lire."
msgstr[1] "Il reste {n} pages à lire."

msgctxt "stillReadingDetail"
msgid "Inktyset can keep reading with the window closed, and tell you when it is done. If you stop, they are read the next time you open Inktyset."
msgstr "Inktyset peut continuer à lire avec la fenêtre fermée, et vous prévenir quand c'est fini. Si vous arrêtez, elles seront lues à la prochaine ouverture d'Inktyset."

msgctxt "keepReading"
msgid "Keep reading"
msgstr "Continuer à lire"

msgctxt "stopAndQuit"
msgid "Stop and quit"
msgstr "Arrêter et quitter"

msgctxt "cancelClose"
msgid "Cancel"
msgstr "Annuler"

msgctxt "allDone"
msgid "All pages are done."
msgstr "Toutes les pages sont terminées."

msgctxt "couldNotStart"
msgid "Inktyset could not start: {error}"
msgstr "Inktyset n'a pas pu démarrer : {error}"

msgctxt "notAnAddress"
msgid "“{url}” is not an address (it starts with http:// or https://)."
msgstr "« {url} » n'est pas une adresse (elle commence par http:// ou https://)."

msgctxt "hostNotFound"
msgid "{host} could not be found on the network."
msgstr "{host} est introuvable sur le réseau."

msgctxt "notLocal"
msgid "{host} is not on this computer or the local network. Inktyset only uses models on your own machines: your pages never leave them."
msgstr "{host} n'est ni sur cet ordinateur ni sur le réseau local. Inktyset n'utilise que des modèles sur vos propres machines : vos pages ne les quittent jamais."

msgctxt "modelFileMissing"
msgid "The model file is not there any more: {file}"
msgstr "Le fichier du modèle n'est plus là : {file}"

msgctxt "serverNoAnswer"
msgid "The model server at {url} did not answer: {error}"
msgstr "Le serveur de modèles à {url} n'a pas répondu : {error}"

msgctxt "noModelOnServer"
msgid "The model server at {url} has no model loaded."
msgstr "Le serveur de modèles à {url} n'a aucun modèle chargé."

msgctxt "modelWrongSize"
msgid "{file} is missing or has the wrong size in that folder."
msgstr "{file} manque dans ce dossier ou n'a pas la bonne taille."

msgctxt "modelWrongSum"
msgid "{file} in that folder is not the expected file (checksum differs)."
msgstr "{file} dans ce dossier n'est pas le fichier attendu (la somme de contrôle diffère)."

msgctxt "chooseModelFile"
msgid "The model (.gguf)"
msgstr "Le modèle (.gguf)"

msgctxt "chooseMmprojFile"
msgid "The model's vision file (mmproj .gguf)"
msgstr "Le fichier de vision du modèle (mmproj .gguf)"

msgctxt "cut"
msgid "Cut"
msgstr "Couper"

msgctxt "copy"
msgid "Copy"
msgstr "Copier"

msgctxt "paste"
msgid "Paste"
msgstr "Coller"

msgctxt "selectAll"
msgid "Select all"
msgstr "Tout sélectionner"

msgctxt "copyFilePath"
msgid "Copy file path"
msgstr "Copier le chemin du fichier"

msgctxt "copyPdfPath"
msgid "Copy PDF path"
msgstr "Copier le chemin du PDF"

msgctxt "showdownFilesNeeded"
msgid "Choose the model's file and its vision file (both .gguf)."
msgstr "Choisissez le fichier du modèle et son fichier de vision (deux .gguf)."

msgctxt "showdownUrlNeeded"
msgid "Type the model server's address."
msgstr "Tapez l'adresse du serveur de modèles."

msgctxt "showdownTooManyExamples"
msgid "With its examples, this model may need more memory than the graphics chip has: try fewer examples."
msgstr "Avec ses exemples, ce modèle demande peut-être plus de mémoire que la carte graphique n'en a : essayez moins d'exemples."

msgctxt "showdownFileGone"
msgid "This model's file isn't there any more: {file}. Download it again, or choose where it is now with Edit."
msgstr "Le fichier de ce modèle n'est plus là : {file}. Téléchargez-le à nouveau, ou indiquez où il se trouve maintenant avec Modifier."

msgctxt "starting"
msgid "Starting…"
msgstr "Démarrage…"

msgctxt "appClosed"
msgid "App closed — reopen Inktyset"
msgstr "Application fermée — rouvrez Inktyset"

msgctxt "ready"
msgid "Ready"
msgstr "Prêt"

msgctxt "loadingModel"
msgid "Loading the model…"
msgstr "Chargement du modèle…"

msgctxt "setupNeeded"
msgid "Setup needed"
msgstr "Installation requise"

msgctxt "modelStopped"
msgid "Model stopped"
msgstr "Modèle arrêté"

msgctxt "readingPage"
msgid "Reading page {n}…"
msgstr "Lecture de la page {n}…"

msgctxt "otherLanguage"
msgid "Other…"
msgstr "Autre…"

msgctxt "writingLanguage"
msgid "Writing language"
msgstr "Langue d'écriture"

#. An example of a language name, typed by the user
msgctxt "langOtherPh"
msgid "e.g. Dutch"
msgstr "p. ex. néerlandais"

msgctxt "output"
msgid "Output"
msgstr "Sortie"

msgctxt "outputTitle"
msgid "What the pages are written in"
msgstr "Le format dans lequel les pages sont écrites"

msgctxt "restartToUpdate"
msgid "Restart to update"
msgstr "Redémarrer pour mettre à jour"

msgctxt "updateTitle"
msgid "Inktyset {v} is downloaded: restart to use it"
msgstr "Inktyset {v} est téléchargé : redémarrez pour l'utiliser"

msgctxt "downloadUpdate"
msgid "Download {v}"
msgstr "Télécharger la {v}"

msgctxt "downloadUpdateTitle"
msgid "Inktyset {v} is out: download its {p} and open it to install it"
msgstr "Inktyset {v} est sortie : téléchargez son {p} et ouvrez-le pour l’installer"

msgctxt "updateHide"
msgid "Hide until the next version"
msgstr "Masquer jusqu’à la prochaine version"

#. {f} is LaTeX or Typst
msgctxt "copyAll"
msgid "Copy all {f}"
msgstr "Copier tout le {f}"

#. {f} is LaTeX or Typst
msgctxt "copyAllTitle"
msgid "Copy the {f} of every finished page"
msgstr "Copier le {f} de toutes les pages terminées"

#. {ext} is .tex or .typ
msgctxt "saveFile"
msgid "Save {ext} file"
msgstr "Enregistrer le fichier {ext}"

msgctxt "saveFileTitle"
msgid "Save one file with every finished page"
msgstr "Enregistrer un fichier avec toutes les pages terminées"

msgctxt "settings"
msgid "Settings"
msgstr "Paramètres"

msgctxt "sessions"
msgid "Sessions"
msgstr "Sessions"

#. Ctrl+B is a keyboard shortcut: Ctrl as printed on keyboards
msgctxt "toggleSessions"
msgid "Show or hide the sessions (Ctrl+B)"
msgstr "Afficher ou masquer les sessions (Ctrl+B)"

msgctxt "newSession"
msgid "New session"
msgstr "Nouvelle session"

#. The name of the first session, the pages Inktyset had before sessions, until the user renames it
msgctxt "firstSession"
msgid "My pages"
msgstr "Mes pages"

#. The name given to a new session; {n} is a number
msgctxt "sessionN"
msgid "Session {n}"
msgstr "Session {n}"

msgctxt "sessionPages"
msgid "{n} page"
msgid_plural "{n} pages"
msgstr[0] "{n} page"
msgstr[1] "{n} pages"

#. {n} pages marked as checked (proofread)
msgctxt "sessionChecked"
msgid "{n} checked"
msgid_plural "{n} checked"
msgstr[0] "{n} vérifiée"
msgstr[1] "{n} vérifiées"

#. {n} pages waiting to be read
msgctxt "sessionWaiting"
msgid "{n} waiting"
msgid_plural "{n} waiting"
msgstr[0] "{n} en attente"
msgstr[1] "{n} en attente"

msgctxt "sessionReading"
msgid "Reading…"
msgstr "Lecture…"

msgctxt "sessionEmpty"
msgid "No pages yet"
msgstr "Aucune page pour l’instant"

msgctxt "sessionNameAria"
msgid "Name of the session"
msgstr "Nom de la session"

msgctxt "renameSession"
msgid "Rename"
msgstr "Renommer"

msgctxt "deleteSession"
msgid "Delete the session"
msgstr "Supprimer la session"

#. {name} is the session's name
msgctxt "confirmDeleteSession"
msgid "Move the session {name} and its pages to the trash?"
msgstr "Mettre la session {name} et ses pages à la corbeille ?"

msgctxt "sessionDeleted"
msgid "Moved to the trash."
msgstr "Mise à la corbeille."

msgctxt "addTitle"
msgid "Add photos or PDF"
msgstr "Ajouter des photos ou un PDF"

msgctxt "addHint"
msgid "Or drag files anywhere onto this window"
msgstr "Ou glissez des fichiers n'importe où dans cette fenêtre"

msgctxt "scanner"
msgid "Scanner"
msgstr "Scanner"

msgctxt "scanning"
msgid "Scanning… keep the lid closed."
msgstr "Numérisation… gardez le capot fermé."

msgctxt "lookingScanners"
msgid "Looking for scanners…"
msgstr "Recherche de scanners…"

msgctxt "noScanner"
msgid "No scanner found. Plug it in and turn it on."
msgstr "Aucun scanner trouvé. Branchez-le et allumez-le."

msgctxt "lookAgain"
msgid "Look again"
msgstr "Chercher à nouveau"

msgctxt "chooseScanner"
msgid "Choose a scanner:"
msgstr "Choisissez un scanner :"

msgctxt "scanPage"
msgid "Scan a page"
msgstr "Numériser une page"

msgctxt "refresh"
msgid "Refresh"
msgstr "Actualiser"

msgctxt "phone"
msgid "Phone"
msgstr "Téléphone"

msgctxt "phoneUnavailable"
msgid "Phone sending is not available."
msgstr "L'envoi depuis un téléphone n'est pas disponible."

msgctxt "phonesConnected"
msgid "{n} phone connected · photos appear here by themselves"
msgid_plural "{n} phones connected · photos appear here by themselves"
msgstr[0] "{n} téléphone connecté · les photos apparaissent ici d'elles-mêmes"
msgstr[1] "{n} téléphones connectés · les photos apparaissent ici d'elles-mêmes"

msgctxt "connectPhone"
msgid "Connect your phone to send photos"
msgstr "Connectez votre téléphone pour envoyer des photos"

msgctxt "phoneStarting"
msgid "The phone receiver is still starting. Try again in a moment."
msgstr "La réception est encore en cours de démarrage. Réessayez dans un instant."

#. {app} is Folder Camera, an Android app
msgctxt "phoneStep1"
msgid "Install {app} on the phone (free on F-Droid)."
msgstr "Installez {app} sur le téléphone (gratuit sur F-Droid)."

#. {app} is Folder Camera; {settings} and {button} are its English buttons: Settings, Scan PC pairing QR
msgctxt "phoneStep2"
msgid "In {app}, open {settings} and tap {button}."
msgstr "Dans {app}, ouvrez {settings} et touchez {button}."

msgctxt "phoneStep3"
msgid "Point the phone at this code."
msgstr "Visez ce code avec le téléphone."

msgctxt "phoneStep4"
msgid "Take photos of your pages. They appear here by themselves."
msgstr "Photographiez vos pages. Elles apparaissent ici d'elles-mêmes."

msgctxt "codeExpires"
msgid "This code works once and expires in {t}."
msgstr "Ce code ne sert qu'une fois et expire dans {t}."

msgctxt "newCode"
msgid "New code"
msgstr "Nouveau code"

msgctxt "showCode"
msgid "Show a pairing code"
msgstr "Afficher un code d'appairage"

msgctxt "connectedPhones"
msgid "Connected phones"
msgstr "Téléphones connectés"

msgctxt "remove"
msgid "Remove"
msgstr "Retirer"

msgctxt "phoneDialogTitle"
msgid "Send photos from your phone"
msgstr "Envoyer des photos depuis votre téléphone"

msgctxt "sameWifi"
msgid "The phone and this computer need to be on the same Wi-Fi."
msgstr "Le téléphone et cet ordinateur doivent être sur le même Wi-Fi."

msgctxt "done"
msgid "Done"
msgstr "Terminé"

#. gigabytes; {n} is a number
msgctxt "gb"
msgid "{n} GB"
msgstr "{n} Go"

#. megabytes; {n} is a number
msgctxt "mb"
msgid "{n} MB"
msgstr "{n} Mo"

msgctxt "checking"
msgid "Checking"
msgstr "Vérification"

msgctxt "unpacking"
msgid "Unpacking"
msgstr "Décompression"

msgctxt "ofTotal"
msgid "{a} of {b}"
msgstr "{a} sur {b}"

msgctxt "stop"
msgid "Stop"
msgstr "Arrêter"

msgctxt "setupTitle"
msgid "Set up Inktyset"
msgstr "Installer Inktyset"

msgctxt "setupText"
msgid "Inktyset reads your pages on this computer, so it needs two downloads, once. Nothing you add ever leaves this computer. Pages you add now wait until it's ready."
msgstr "Inktyset lit vos pages sur cet ordinateur : il lui faut donc deux téléchargements, une seule fois. Rien de ce que vous ajoutez ne quitte cet ordinateur. Les pages ajoutées maintenant attendent qu'il soit prêt."

msgctxt "setupTextModel"
msgid "Inktyset reads your pages on this computer, so it needs to download its model, once. Nothing you add ever leaves this computer. Pages you add now wait until it's ready."
msgstr "Inktyset lit vos pages sur cet ordinateur : il lui faut donc télécharger son modèle, une seule fois. Rien de ce que vous ajoutez ne quitte cet ordinateur. Les pages ajoutées maintenant attendent qu'il soit prêt."

msgctxt "engineName"
msgid "Engine (llama.cpp)"
msgstr "Moteur (llama.cpp)"

msgctxt "modelName"
msgid "Model (Qwen3.5 9B vision)"
msgstr "Modèle (Qwen3.5 9B vision)"

msgctxt "setupServer"
msgid "You chose a model server on your own network: enter its address in Settings, under “Model and engine”."
msgstr "Vous avez choisi un serveur de modèles sur votre propre réseau : indiquez son adresse dans les Paramètres, sous « Modèle et moteur »."

msgctxt "setupFiles"
msgid "You chose model files of your own: pick them in Settings, under “Model and engine”. Inktyset's engine runs them, a download needed once."
msgstr "Vous avez choisi vos propres fichiers de modèle : choisissez-les dans les Paramètres, sous « Modèle et moteur ». Le moteur d'Inktyset les fait tourner ; il se télécharge une seule fois."

msgctxt "openModelSettings"
msgid "Open the model settings"
msgstr "Ouvrir les réglages du modèle"

msgctxt "noEngine"
msgid "There is no ready-made engine for this system yet. If you have your own llama.cpp build, set its llama-server in Settings."
msgstr "Il n'existe pas encore de moteur tout prêt pour ce système. Si vous avez votre propre version de llama.cpp, indiquez son llama-server dans les Paramètres."

msgctxt "download"
msgid "Download ({size})"
msgstr "Télécharger ({size})"

msgctxt "haveModel"
msgid "I already have the model files…"
msgstr "J'ai déjà les fichiers du modèle…"

msgctxt "haveModelTitle"
msgid "Use Qwen3.5-9B-Q4_K_M.gguf and mmproj-F16.gguf you already downloaded"
msgstr "Utiliser Qwen3.5-9B-Q4_K_M.gguf et mmproj-F16.gguf déjà téléchargés"

msgctxt "gpuLater"
msgid "checked once the engine is downloaded"
msgstr "vérifiée une fois le moteur téléchargé"

msgctxt "gpuNone"
msgid "none the engine can use"
msgstr "aucune utilisable par le moteur"

#. {mem} is a size like 16 GB; {gpu} names graphics chips
msgctxt "thisComputer"
msgid "This computer: {mem} of memory · graphics: {gpu}. With a graphics chip a page takes a minute or two; on the processor alone, several minutes."
msgstr "Cet ordinateur : {mem} de mémoire · carte graphique : {gpu}. Avec une puce graphique, une page prend une à deux minutes ; avec le processeur seul, plusieurs minutes."

msgctxt "memLow"
msgid "The model needs about {need} of memory; this computer has {have}. Reading will probably fail."
msgstr "Le modèle a besoin d'environ {need} de mémoire ; cet ordinateur en a {have}. La lecture échouera probablement."

msgctxt "memTight"
msgid "This computer has {have} of memory: close other programs while pages are read."
msgstr "Cet ordinateur a {have} de mémoire : fermez les autres programmes pendant la lecture des pages."

msgctxt "noGpu"
msgid "No graphics chip the engine can use was found: pages are read by the processor, several minutes each."
msgstr "Aucune puce graphique utilisable par le moteur n'a été trouvée : les pages sont lues par le processeur, plusieurs minutes chacune."

msgctxt "smallGpu"
msgid "The graphics chip has little memory for this model: reading may fall back to the processor and be slow."
msgstr "La puce graphique a peu de mémoire pour ce modèle : la lecture peut se rabattre sur le processeur et être lente."

msgctxt "appLanguage"
msgid "Language of the app"
msgstr "Langue de l'application"

msgctxt "appLanguageAuto"
msgid "Automatic (the computer's language)"
msgstr "Automatique (la langue de l'ordinateur)"

msgctxt "appLanguageNote"
msgid "The language your pages are written in is chosen at the top (Writing language)."
msgstr "La langue dans laquelle vos pages sont écrites se choisit en haut (Langue d'écriture)."

msgctxt "helpTranslate"
msgid "Help translate Inktyset"
msgstr "Aidez à traduire Inktyset"

msgctxt "usingInstalledLatex"
msgid "Using the installed LaTeX: {d}"
msgstr "LaTeX installé utilisé : {d}"

msgctxt "using"
msgid "Using {d}"
msgstr "Utilisé : {d}"

msgctxt "notUsedYet"
msgid "Not used yet: the first preview decides."
msgstr "Pas encore utilisé : le premier aperçu décidera."

msgctxt "latexForPreviews"
msgid "LaTeX for the previews"
msgstr "LaTeX pour les aperçus"

msgctxt "auto"
msgid "Automatic"
msgstr "Automatique"

msgctxt "autoHelp"
msgid "The LaTeX installed on this computer if it works for your language, otherwise the built-in one."
msgstr "Le LaTeX installé sur cet ordinateur s'il fonctionne pour votre langue, sinon celui intégré."

msgctxt "installedLatex"
msgid "Installed LaTeX"
msgstr "LaTeX installé"

msgctxt "found"
msgid "Found: {list}"
msgstr "Trouvé : {list}"

msgctxt "noneFound"
msgid "None found on this computer."
msgstr "Aucun trouvé sur cet ordinateur."

msgctxt "builtin"
msgid "Built-in (Tectonic)"
msgstr "Intégré (Tectonic)"

msgctxt "downloaded"
msgid "Downloaded."
msgstr "Téléchargé."

msgctxt "included"
msgid "Included with Inktyset."
msgstr "Fourni avec Inktyset."

msgctxt "tectonicHelp"
msgid "Downloaded when first needed ({size}); then it fetches the LaTeX packages a page uses, once."
msgstr "Téléchargé au premier besoin ({size}) ; il récupère ensuite, une seule fois, les paquets LaTeX qu'une page utilise."

msgctxt "usingInstalledTypst"
msgid "Using the installed Typst: {d}"
msgstr "Typst installé utilisé : {d}"

msgctxt "typstHelp"
msgid "For Typst output; downloaded when first needed ({size})."
msgstr "Pour la sortie Typst ; téléchargé au premier besoin ({size})."

#. Title of a section of Settings: going from the preview to the text and back, as in TeXstudio
msgctxt "goToSource"
msgid "Go to the source"
msgstr "Aller à la source"

msgctxt "goToSourceSetting"
msgid "Ctrl+click between the preview and the text"
msgstr "Ctrl+clic entre l’aperçu et le texte"

#. Ctrl and Alt are keys, as printed on keyboards
msgctxt "goToSourceHelp"
msgid "As in TeXstudio: Ctrl+click a spot of the preview to go to its line in the text, and a line of the text to see where it is on the preview. Ctrl+click then no longer adds a cursor in the text: Alt+click does."
msgstr "Comme dans TeXstudio : Ctrl+clic sur un endroit de l’aperçu pour aller à sa ligne dans le texte, et sur une ligne du texte pour voir où elle se trouve dans l’aperçu. Ctrl+clic n’ajoute alors plus de curseur dans le texte : c’est Alt+clic."

msgctxt "phoneSetting"
msgid "Receive photos from a phone (Folder Camera)"
msgstr "Recevoir des photos d'un téléphone (Folder Camera)"

msgctxt "phoneSettingHelp"
msgid "Off by default. When on, Inktyset listens on your Wi-Fi for photos from phones you pair with a QR code."
msgstr "Désactivé par défaut. Une fois activé, Inktyset reçoit sur votre Wi-Fi les photos des téléphones appairés avec un code QR."

msgctxt "firewall"
msgid "Windows will ask once to allow it through the firewall."
msgstr "Windows demandera une fois de l'autoriser dans le pare-feu."

msgctxt "noScannerShort"
msgid "No scanner found."
msgstr "Aucun scanner trouvé."

msgctxt "lookForScanners"
msgid "Look for scanners"
msgstr "Chercher des scanners"

msgctxt "saneNote"
msgid "Scanning needs SANE (scanimage), available on Linux and macOS. You can always add scanned files as photos or PDFs."
msgstr "La numérisation nécessite SANE (scanimage), disponible sous Linux et macOS. Vous pouvez toujours ajouter des fichiers numérisés comme photos ou PDF."

msgctxt "modelEngine"
msgid "Model and engine"
msgstr "Modèle et moteur"

msgctxt "modelFiles"
msgid "Model files: {p}"
msgstr "Fichiers du modèle : {p}"

msgctxt "otherFolder"
msgid "Use model files from another folder…"
msgstr "Utiliser les fichiers du modèle d'un autre dossier…"

msgctxt "ownCopy"
msgid "Use Inktyset's own copy"
