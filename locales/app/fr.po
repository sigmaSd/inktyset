msgid "Finishing {n} page in the background. Open Inktyset to watch."
msgid_plural "Finishing {n} pages in the background. Open Inktyset to watch."
msgstr[0] "Inktyset termine {n} page en arrière-plan. Ouvrez-le pour suivre."
msgstr[1] "Inktyset termine {n} pages en arrière-plan. Ouvrez-le pour suivre."

