{
  "name": "hand2tex",
  "version": "0.2.0",
  "private": true,
  "description": "Turn photos and scans of handwritten math into LaTeX, on your own computer",
  "homepage": "https://github.com/sigmaSd/hand2tex",
  "license": "GPL-3.0-or-later",
  "author": "Bedis Nbiba",
  "type": "module",
  "main": "dist/app/electron.mjs",
  "scripts": {
    "dev": "vp build && vp pack && electron . --dev",
    "start": "electron .",
    "dist": "vp build && vp pack && electron-builder --config shell/electron/builder.yml",
    "appimage": "vp build && vp pack && electron-builder --config shell/electron/builder.yml --linux AppImage"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "folder-camera-receiver": "https://github.com/sigmasd/folder-camera/releases/download/receiver-engine-v1.3.0/folder-camera-receiver-1.3.0.tgz"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "pdfjs-dist": "6.5.438",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "pnpm@12.11.2",
  "desktopName": "hand2tex.desktop",
  "productName": "hand2tex"
}
