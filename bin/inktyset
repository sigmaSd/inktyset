#!/usr/bin/env bash
# Inktyset from this checkout (what the menu entry runs): rebuilds first when the code changed since the last
# build, so the menu always starts the current code. Arguments go to the app (--dev, --no-window).
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."
export TMPDIR="${TMPDIR:-$HOME/dev/tmp}"
mkdir -p "$TMPDIR"
VP="$(command -v vp || echo "$HOME/.local/share/vite-plus/bin/vp")"

[[ -d node_modules ]] || "$VP" install
built=dist/app/electron.mjs
if [[ ! -f $built || ! -f app/ui/dist/index.html ]] ||
   [[ -n $(find src shell app/ui -path app/ui/dist -prune -o -newer "$built" -type f -print -quit) ]] ||
   [[ package.json -nt $built || vite.config.ts -nt $built ]]; then
  "$VP" build >/dev/null
  "$VP" pack >/dev/null
fi
exec ./node_modules/.bin/electron . "$@"
